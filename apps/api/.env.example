PORT=4000
# Comma-separated list of allowed web origins
WEB_ORIGIN=http://localhost:3000
# live | chunked | mock
TRANSCRIBER=mock
# gemini | mock
TRANSLATOR=mock
GEMINI_API_KEY=
# Live speech-to-text model and text model (translation + chunked fallback), benchmarked 2026-09-25:
# gemini-3.5-flash-lite translated a caption in ~0.8 s vs ~6 s for gemini-3.8-flash.
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
MAX_SESSIONS=12
SAMPLES_DIR=../../samples
